# Copy these into Streamlit Cloud → your app → Settings → Secrets
# (or into .streamlit/secrets.toml when running on your own computer).
# NEVER commit real values to GitHub.

# --- AI (free key from https://console.groq.com/keys) ---
GROQ_API_KEY = "gsk_xxxxxxxxxxxxxxxxxxxxxxxx"
# Optional: change models without touching code
# GROQ_MODEL = "llama-3.3-70b-versatile"
# GROQ_FALLBACK_MODEL = "llama-3.1-8b-instant"

# --- Who is an admin (sees the dashboard instead of the chat) ---
# Put Google emails and/or usernames from [passwords]
ADMIN_USERS = ["phanuwat.w@areetechnology.com", "admin"]

# --- Who may sign in with Google ---
# Everyone with an email on these domains...
ALLOWED_DOMAINS = ["areetechnology.com"]
# ...plus these individual addresses (e.g. personal Gmail accounts)
ALLOWED_EMAILS = []

# --- Permanent chat history in Google Sheets (optional but recommended) ---
GSHEET_URL = "https://docs.google.com/spreadsheets/d/XXXXXXXX/edit"
# Its service-account key goes in [gcp_service_account] at the bottom.

# --- Google sign-in (see README, section "Sign in with Google") ---
[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "a-long-random-string"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# --- Optional: username/password login (remove this section to allow Google only) ---
[passwords]
admin = "change-me"

[gcp_service_account]
type = "service_account"
project_id = "your-project"
private_key_id = "xxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n"
client_email = "oran-ai@your-project.iam.gserviceaccount.com"
client_id = "xxxx"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "xxxx"
